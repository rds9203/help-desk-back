// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabla de Roles
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // "admin", "user", "manager", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  users User[]

  @@map("roles")
}

// Tabla de Usuarios
model User {
  id                Int      @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String   @unique
  password          String   // Hash de la contraseña
  birthDate         DateTime
  position          String   // Cargo en la empresa
  startDate         DateTime // Fecha de inicio en la compañía
  hasDebt           Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  roleId            Int
  role              Role     @relation(fields: [roleId], references: [id])
  credits           Credit[]
  paymentHistory    PaymentHistory[]

  @@map("users")
}

// Tabla de Tipos de Interés
model InterestRate {
  id                Int      @id @default(autoincrement())
  name              String   // "Nuevo empleado", "1-2 años", "3-5 años", etc.
  minMonths         Int      // Meses mínimos en la empresa
  maxMonths         Int?     // Meses máximos en la empresa (null = sin límite)
  rate              Decimal  @db.Decimal(5, 2) // Tasa de interés (ej: 12.50)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  credits           Credit[]

  @@map("interest_rates")
}

// Tabla de Créditos
model Credit {
  id                Int      @id @default(autoincrement())
  creditType        String   // "Préstamo Personal", "Línea de Crédito", etc.
  loanAmount        Decimal  @db.Decimal(12, 2) // Monto del préstamo
  outstandingAmount Decimal  @db.Decimal(12, 2) // Monto pendiente
  installmentAmount Decimal  @db.Decimal(12, 2) // Cuota mensual
  totalInstallments Int      // Total de cuotas
  pendingInstallments Int    // Cuotas pendientes
  startDate         DateTime
  endDate           DateTime
  status            String   // "ACTIVO", "VENCIDO", "PAGADO", "CANCELADO"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
  interestRateId    Int
  interestRate      InterestRate @relation(fields: [interestRateId], references: [id])
  paymentHistory    PaymentHistory[]

  @@map("credits")
}

// Tabla de Historial de Pagos
model PaymentHistory {
  id                Int      @id @default(autoincrement())
  installmentNumber Int      // Número de cuota
  amount            Decimal  @db.Decimal(12, 2) // Monto pagado
  interestAmount    Decimal  @db.Decimal(12, 2) // Monto de interés
  principalAmount   Decimal  @db.Decimal(12, 2) // Monto de capital
  remainingBalance  Decimal  @db.Decimal(12, 2) // Saldo restante después del pago
  paymentDate       DateTime
  dueDate           DateTime // Fecha de vencimiento de la cuota
  status            String   // "PAGADO", "VENCIDO", "PENDIENTE"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
  creditId          Int
  credit            Credit   @relation(fields: [creditId], references: [id])

  @@map("payment_history")
}
