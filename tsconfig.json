{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/functions/tickets/**",
    "src/functions/tickets-comments/**",
    "src/functions/tickets-update/**",
    "src/functions/reservations/**",
    "src/functions/resources/**",
    "src/functions/vacations/**",
    "src/functions/vacations-days/**",
    "src/functions/vacations-request/**",
    "src/functions/notifications/**",
    "src/functions/notifications-read/**",
    "src/functions/notifications-unread-count/**"
  ]
}

