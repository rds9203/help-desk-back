# MySQL Database Configuration
# Formato de conexión: mysql://usuario:contraseña@servidor:puerto/base_datos

# Configuración local de MySQL
DATABASE_URL="mysql://root:1234@localhost:3306/help-desk"

# Configuración alternativa (si usas otro usuario)
# DATABASE_URL="mysql://usuario:contraseña@localhost:3306/help-desk"

# Puerto del servidor Express
PORT=3001

# Configuración de CORS
CORS_ORIGIN=http://localhost:4200

